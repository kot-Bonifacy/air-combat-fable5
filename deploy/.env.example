# Faza 13: pełny stack (frontend + backend WS). Skopiuj do `.env` NA VPS (nie wersjonuj —
# patrz .gitignore). docker-compose czyta `.env` z katalogu compose.
#
# Backend serwera gry jest skromny w konfiguracji: czyta tylko LOG_LEVEL i NODE_ENV.
# Wartości poniżej są też domyślne w docker-compose.yml — plik .env służy do ich nadpisania.

# Poziom logów serwera (pino): trace|debug|info|warn|error. Produkcja: info.
LOG_LEVEL=info

# Tryb Node (wpływa m.in. na format logów/wydajność). Produkcja: production.
NODE_ENV=production

# --- Logowanie sesji graczy do MySQL (kto/kiedy gra → phpMyAdmin :8081) ---
# Backend zapisuje wiersz na każdą sesję do bazy portfolio (kontener portfolio_db).
# Wymaga: (1) backend w sieci portfolio_default (patrz docker-compose.yml, sekcja networks),
#         (2) kompletu 4 zmiennych poniżej — brak którejkolwiek = logowanie WYŁĄCZONE (gra działa).
# Wartości domyślne to dane bazy portfolio z config.php. HOST = nazwa kontenera bazy.
DB_LOG_HOST=portfolio_db
DB_LOG_PORT=3306
DB_LOG_USER=39790326_temp
DB_LOG_PASSWORD=Mar2chewka1
DB_LOG_DATABASE=39790326_temp
